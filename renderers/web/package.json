{
  "name": "tiny-harness-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate": "bun run scripts/generate-types.ts",
    "typecheck": "bun run generate && tsc --noEmit",
    "build": "bun run generate && tsc --noEmit && vite build",
    "dev": "bun run generate && vite",
    "test": "bun run generate && vitest run",
    "test:visual": "bun run build && playwright test --project=visual",
    "test:a11y": "bun run build && playwright test --project=a11y"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@a2ui/react": "^0.13.0",
    "@a2ui/web_core": "^0.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^26.0.0",
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
